---
import Img from './Img.astro';

interface Props {
  title: string;
  image: string;
}

const { title, image } = Astro.props;
---

<section class="page-hero">
  <Img
    src={image}
    alt=""
    widths={[640, 1440]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    quality={55}
    class="page-hero-img"
  />
  <h1>{title}</h1>
</section>

<style>
  .page-hero {
    overflow: hidden;
  }
</style>
