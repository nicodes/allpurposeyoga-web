---
import Img from './Img.astro';

const trainings = [
  { label: 'Mantra Magic', href: '/nada-yoga/' },
  {
    label: 'Bridging The Gap To Teaching',
    href: 'https://momence.com/All-Purpose-Yoga/Bridging-The-Gap-To-Teaching/128777664?skipPreview=true',
  },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => href.startsWith('/') && (href.replace(/\/+$/, '') || '/') === currentPath;
const hasActiveTraining = trainings.some((item) => isCurrent(item.href));
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo" aria-label="All Purpose Yoga home">
      <Img
        src="/wp-content/uploads/2025/08/AllPurposeYogaRound-compressed.png"
        alt="All Purpose Yoga"
        widths={[60, 120]}
        sizes="(min-width: 1024px) 60px, 48px"
        loading="eager"
        class="logo-img header-logo"
      />
    </a>

    <nav class="secondary-nav" aria-label="Explore All Purpose Yoga">
      <a href="/schedule/" aria-current={isCurrent('/schedule/') ? 'page' : undefined}>Schedule</a>
      <a href="/events/" aria-current={isCurrent('/events/') ? 'page' : undefined}>Events</a>
      <details class="trainings-menu">
        <summary class:list={{ active: hasActiveTraining }}>Trainings</summary>
        <ul>
          {trainings.map((item) => (
            <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </details>
      <a href="/about/" aria-current={isCurrent('/about/') ? 'page' : undefined}>About</a>
      <a href="/connect/" aria-current={isCurrent('/connect/') ? 'page' : undefined}>Connect</a>
    </nav>

    <details class="mobile-more">
      <summary aria-label="Open more navigation">
        <span></span><span></span><span></span>
      </summary>
      <nav aria-label="More navigation">
        <a href="/schedule/" aria-current={isCurrent('/schedule/') ? 'page' : undefined}>Schedule</a>
        <a href="/events/" aria-current={isCurrent('/events/') ? 'page' : undefined}>Events</a>
        <a href="/nada-yoga/" aria-current={isCurrent('/nada-yoga/') ? 'page' : undefined}>Mantra Magic</a>
        <a href={trainings[1].href}>Bridging The Gap To Teaching</a>
        <a href="/about/" aria-current={isCurrent('/about/') ? 'page' : undefined}>About Us</a>
        <a href="/connect/" aria-current={isCurrent('/connect/') ? 'page' : undefined}>Connect</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid rgba(51, 51, 51, 0.08);
    background: rgba(242, 238, 215, 0.97);
    backdrop-filter: blur(12px);
  }

  .header-inner {
    position: relative;
    display: flex;
    max-width: var(--max-width);
    min-height: 64px;
    margin: 0 auto;
    padding: 0.3rem 0.75rem;
    align-items: center;
    gap: 0.55rem;
  }

  .logo {
    flex: 0 0 auto;
    margin-right: auto;
  }

  .site-header :global(.header-logo) {
    width: 48px;
    height: auto;
  }

  .secondary-nav {
    display: none;
  }

  .mobile-more {
    flex: 0 0 auto;
  }

  .mobile-more > summary {
    display: grid;
    width: 36px;
    height: 36px;
    place-content: center;
    gap: 4px;
    cursor: pointer;
  }

  .mobile-more > summary::-webkit-details-marker,
  .trainings-menu > summary::-webkit-details-marker {
    display: none;
  }

  .mobile-more > summary::marker,
  .trainings-menu > summary::marker {
    content: "";
  }

  .mobile-more > summary:focus-visible,
  .secondary-nav a:focus-visible,
  .trainings-menu > summary:focus-visible {
    outline: 2px solid var(--maroon);
    outline-offset: 3px;
  }

  .mobile-more > summary span {
    width: 22px;
    height: 2px;
    background: var(--text);
  }

  .mobile-more nav {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    display: grid;
    padding: 1rem 1.25rem 1.25rem;
    background: var(--maroon);
    box-shadow: 0 18px 40px rgba(51, 24, 31, 0.22);
  }

  .mobile-more nav a {
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    color: var(--white);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .mobile-more nav a:last-child {
    border-bottom: 0;
  }

  .mobile-more nav a[aria-current="page"] {
    color: var(--gold);
  }

  @media (max-width: 359px) {
    .header-inner {
      min-height: 60px;
      padding-right: 0.5rem;
      padding-left: 0.5rem;
      gap: 0.25rem;
    }

    .site-header :global(.header-logo) {
      width: 44px;
    }

    .mobile-more > summary {
      width: 32px;
      height: 32px;
    }
  }

  @media (min-width: 1024px) {
    .header-inner {
      min-height: 76px;
      padding: 0.35rem 1.25rem;
      gap: 2rem;
    }

    .site-header :global(.header-logo) {
      width: 60px;
    }

    .secondary-nav {
      display: flex;
      align-items: center;
      gap: 2rem;
    }

    .secondary-nav > a,
    .trainings-menu > summary {
      color: var(--text);
      font-size: 0.76rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .secondary-nav > a:hover,
    .secondary-nav > a[aria-current="page"],
    .trainings-menu > summary:hover,
    .trainings-menu > summary.active {
      color: var(--maroon);
    }

    .trainings-menu {
      position: relative;
    }

    .trainings-menu > summary {
      cursor: pointer;
    }

    .trainings-menu > summary::after {
      content: " +";
      color: var(--maroon);
    }

    .trainings-menu[open] > summary::after {
      content: " −";
    }

    .trainings-menu ul {
      position: absolute;
      top: calc(100% + 1rem);
      left: -1.25rem;
      width: 260px;
      margin: 0;
      padding: 0.75rem;
      border-radius: 14px;
      background: var(--white);
      list-style: none;
      box-shadow: 0 16px 38px rgba(51, 24, 31, 0.16);
    }

    .trainings-menu li + li {
      border-top: 1px solid rgba(51, 51, 51, 0.1);
    }

    .trainings-menu li a {
      display: block;
      padding: 0.75rem 0.5rem;
      color: var(--text);
      font-size: 0.8rem;
    }

    .trainings-menu li a:hover,
    .trainings-menu li a[aria-current="page"] {
      color: var(--maroon);
    }

    .mobile-more {
      display: none;
    }
  }
</style>
