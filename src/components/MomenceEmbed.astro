---
interface Props {
  ctaText: string;
  introText: string;
}

const { ctaText, introText } = Astro.props;
---

<section class="section embed-section">
  <div class="container">
    <div class="card embed-card center">
      <p>{introText}</p>
      <a class="btn" href="https://momence.com/All-Purpose-Yoga">{ctaText}</a>
    </div>
  </div>
</section>

<style>
  .embed-section {
    background: linear-gradient(180deg, rgba(234, 225, 214, 0.61) 0%, rgba(234, 225, 214, 0.33) 100%);
  }

  .embed-card {
    border-radius: 12px;
    padding: 3rem 1.5rem;
  }

  .embed-card p {
    margin-bottom: 1.5rem;
  }
</style>
