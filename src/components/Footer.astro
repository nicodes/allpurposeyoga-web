</footer>

<style>
  .site-footer {
    background: var(--cream);
    padding-top: 35px;
    font-size: 0.875rem;
  }

  .footer-grid {
    display: grid;
    gap: 2rem;
    text-align: center;
    justify-items: center;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 200px 1fr 1.5fr;
      text-align: left;
      justify-items: start;
      align-items: start;
    }
  }

  .footer-logo img {
    width: 200px;
    max-width: 100%;
  }

  .footer-contact strong {
    display: block;
    color: var(--maroon);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 0.5rem;
  }

  .icons {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .icons {
      justify-content: flex-start;
    }
  }

  .icons a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--maroon);
    color: var(--white);
  }

  .icons a:hover {
    background: var(--gold);
    color: var(--white);
  }

  .footer-bottom {
    margin-top: 2rem;
    padding-top: 1rem;
    padding-bottom: 1.5rem;
    border-top: 1px solid rgba(51, 51, 51, 0.1);
    text-align: center;
  }

  .footer-bottom p {
    margin: 0.25rem 0;
  }
</style>
