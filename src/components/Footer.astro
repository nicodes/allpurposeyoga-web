  </div>

  <div class="container footer-bottom">
    <p>
      <a href="https://stripe.com/privacy" target="_blank" rel="noopener">Stripe Privacy Policy</a>
      |
      <a href="https://momence.com/privacy-policy/documents/Momence-Privacy-Policy.pdf" target="_blank" rel="noopener">Momence Privacy Policy</a>
    </p>
    <p>
      © Copyright {year} All Purpose Yoga | All rights reserved | Built by:
      <a href="https://overhaulics.com" target="_blank" rel="nofollow noopener">Overhaulics</a>
    </p>
