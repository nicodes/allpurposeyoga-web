---
import Base from '../layouts/Layout.astro';
import Img from '../components/Img.astro';
import { teachers } from '../data/teachers';
---

<Base
  title="About Us - All Purpose Yoga"
  description="All Purpose Yoga is a small locally operated and female owned yoga studio in Boulder, CO. Get to know our inspired teachers."
>
  <section class="section">
    <div class="container intro-grid">
      <div>
        <p class="kicker">What is our intention?</p>
        <h2>It’s All In The Name</h2>
        <p>
          The name ‘All Purpose Yoga’ is a play on words for living a purposeful life and practicing
          yoga with purpose. We materialized from a place of versatility, inclusivity and adaptability
          for all levels, goals, and people in everyday life. With a commitment to facilitating a
          comfortable and welcoming environment, our highly skilled teachers cater to all student
          levels and none of our classes have added heat.
        </p>
        <p>
          Sangha is a Sanskrit word for community — the people we practice alongside, grow alongside,
          and support along the way. We named our membership Sangha because we believe yoga is about
          more than what happens on your mat. It’s about having a place to belong, people to practice
          with, and a community that helps you keep showing up. Sangha is our invitation to practice
          together.
        </p>
        <p>
          At All Purpose Yoga, we are dedicated to being a purpose driven organization. Seva Yoga is
          the Yoga of Selfless Service. Seva stems from two branches of Yoga; Karma Yoga (Yoga of
          Action) and Bhakti Yoga (Devotion inspired by Divine Love).
        </p>
      </div>
      <Img
        src="/wp-content/uploads/2025/12/IMG_0068.jpeg"
        alt="All Purpose Yoga community"
        widths={[480, 768, 1024]}
        sizes="(min-width: 900px) 45vw, calc(100vw - 2.5rem)"
        class="intro-grid-img"
      />
    </div>
  </section>

  <section class="section teachers-section">
    <div class="container">
      <p class="kicker center">get to know your</p>
      <h2 class="center">inspired teachers</h2>

      <div class="teacher-grid">
        {teachers.map((t, index) => (
          <article class="card teacher-card">
            <Img src={t.image} alt={t.name} widths={[400, 640]} sizes="(min-width: 1000px) 33vw, (min-width: 640px) 50vw, calc(100vw - 2.5rem)" class="teacher-card-img" />
            <div class="teacher-body">
              <h3>{t.name}</h3>
            </div>
            <button
              class="bio-trigger"
              type="button"
              popovertarget={`teacher-bio-${index}`}
              aria-label={`Read ${t.name}'s biography`}
            ></button>
            <div
              id={`teacher-bio-${index}`}
              class="teacher-dialog"
              aria-labelledby={`teacher-name-${index}`}
              popover
            >
              <div class="dialog-shell">
                <div class="dialog-header">
                  <h3 id={`teacher-name-${index}`}>{t.modalName ?? t.name}</h3>
                  <button
                    class="dialog-close"
                    type="button"
                    popovertarget={`teacher-bio-${index}`}
                    popovertargetaction="hide"
                    aria-label="Close biography"
                  >
                    <span aria-hidden="true">×</span>
                  </button>
                </div>
                <div class="dialog-body">
                  <Img
                    src={t.portrait}
                    alt={t.modalName ?? t.name}
                    widths={[200, 400]}
                    sizes="200px"
                    class="dialog-portrait"
                  />
                  <div class="dialog-copy">
                    {t.bio.split('\n\n').map((p) => <p>{p}</p>)}
                  </div>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

</Base>

<style>
  .intro-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .intro-grid {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .teachers-section {
    background: var(--beige);
  }

  .teacher-grid {
    display: grid;
    gap: 2rem;
    margin-top: 3rem;
  }

  @media (min-width: 640px) {
    .teacher-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .teacher-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .teacher-body {
    padding: 1.25rem 1.5rem 1.5rem;
  }

  .teacher-card {
    position: relative;
  }

  .teacher-body h3 {
    margin: 0;
  }

  .bio-trigger {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: inherit;
    background: transparent;
    cursor: pointer;
  }

  .bio-trigger:focus-visible {
    outline: 3px solid var(--maroon);
    outline-offset: -3px;
  }

  .dialog-close:focus-visible {
    outline: 2px solid var(--maroon);
    outline-offset: 4px;
  }

  .teacher-dialog {
    position: fixed;
    inset: 0;
    width: min(840px, calc(100% - 2rem));
    max-width: none;
    max-height: none;
    margin: auto;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: 18px;
    background: var(--white);
    color: var(--text);
    box-shadow: 0 28px 90px rgba(30, 15, 19, 0.35);
  }

  .teacher-dialog::backdrop {
    background: rgba(20, 13, 15, 0.78);
    backdrop-filter: blur(3px);
  }

  .dialog-shell {
    display: flex;
    max-height: calc(100dvh - 2rem);
    flex-direction: column;
  }

  .dialog-header {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid rgba(51, 51, 51, 0.1);
  }

  .dialog-header h3 {
    margin: 0;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
  }

  .dialog-close {
    display: grid;
    width: 40px;
    height: 40px;
    flex: 0 0 auto;
    padding: 0;
    place-items: center;
    border: 1px solid rgba(160, 44, 73, 0.25);
    border-radius: 50%;
    background: var(--cream);
    color: var(--maroon);
    cursor: pointer;
  }

  .dialog-close span {
    font-size: 1.7rem;
    line-height: 1;
    transform: translateY(-1px);
  }

  .dialog-body {
    display: grid;
    gap: 1.5rem;
    padding: 1.5rem;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  :global(.dialog-portrait) {
    width: 160px;
    height: auto;
    margin: 0 auto;
    border-radius: 12px;
  }

  .dialog-copy p:last-child {
    margin-bottom: 0;
  }

  :global(html:has(.teacher-dialog:popover-open)) {
    overflow: hidden;
  }

  @media (min-width: 700px) {
    .dialog-body {
      grid-template-columns: 200px minmax(0, 1fr);
      gap: 2rem;
      padding: 2rem;
    }

    :global(.dialog-portrait) {
      position: sticky;
      top: 0;
      width: 200px;
    }
  }
</style>
