---
import Base from '../layouts/Layout.astro';
---

<Base
  title="Schedule | All Purpose Yoga"
  description="View the live weekly class schedule at All Purpose Yoga in Boulder, CO and reserve your next class."
>
  <section class="schedule-section" aria-label="Live class schedule">
    <div class="container">
      <div class="schedule-widget">
        <div class="embed-prompt" data-schedule-prompt>
          <h2>Find your next practice</h2>
          <p>Load the live Momence calendar to browse classes, workshops, and events.</p>
          <button class="load-widget" type="button" data-load-schedule>Load live schedule</button>
          <noscript>
            <a class="load-widget" href="https://momence.com/All-Purpose-Yoga">View schedule on Momence</a>
          </noscript>
        </div>
        <div id="ribbon-schedule" hidden></div>
        <script is:inline>
          (() => {
            const view = new URLSearchParams(window.location.search).get('view');
            const mount = document.querySelector('#ribbon-schedule');
            const prompt = document.querySelector('[data-schedule-prompt]');
            const loadButton = document.querySelector('[data-load-schedule]');

            if (!mount || !prompt || !loadButton) return;

            const addEventsTab = () => {
              const tabs = [...mount.querySelectorAll('.momence-event_type_select-button')];

              if (tabs.length < 2 || mount.querySelector('.apy-events-tab')) return false;

              const eventsTab = tabs[view === 'events' ? 0 : 1].cloneNode(true);
              eventsTab.firstChild.nodeValue = 'Events';
              eventsTab.classList.add('apy-events-tab');
              eventsTab.setAttribute('aria-pressed', view === 'events' ? 'true' : 'false');
              eventsTab.addEventListener('click', () => {
                window.location.assign('/schedule/?view=events');
              });
              tabs[1].after(eventsTab);

              if (view === 'events') {
                tabs[0].className = tabs[1].className;
                tabs[0].querySelector('div')?.remove();
                tabs[0].addEventListener(
                  'click',
                  (event) => {
                    event.stopImmediatePropagation();
                    window.location.assign('/schedule/');
                  },
                  true,
                );
                tabs[1].addEventListener(
                  'click',
                  (event) => {
                    event.stopImmediatePropagation();
                    window.location.assign('/schedule/?view=workshops');
                  },
                  true,
                );
              } else if (view === 'workshops') {
                tabs[1].click();
                window.history.replaceState({}, '', '/schedule/');
              }

              return true;
            };

            const loadSchedule = () => {
              loadButton.setAttribute('disabled', '');
              loadButton.textContent = 'Loading schedule...';
              mount.removeAttribute('hidden');

              const scheduleScript = document.createElement('script');
              scheduleScript.async = true;
              scheduleScript.type = 'module';
              scheduleScript.setAttribute('host_id', '87939');
              scheduleScript.setAttribute('teacher_ids', '[]');
              scheduleScript.setAttribute('location_ids', '[]');
              scheduleScript.setAttribute('tag_ids', view === 'events' ? '[173863]' : '[]');
              scheduleScript.setAttribute('default_filter', 'show-all');
              scheduleScript.setAttribute('locale', 'en');
              scheduleScript.src = 'https://momence.com/plugin/host-schedule/host-schedule.js';
              scheduleScript.addEventListener('load', () => {
                prompt.setAttribute('hidden', '');
              });
              scheduleScript.addEventListener('error', () => {
                const message = document.createElement('p');
                const link = document.createElement('a');
                link.href = 'https://momence.com/All-Purpose-Yoga';
                link.textContent = 'View the schedule on Momence.';
                message.append('We could not load the calendar. ', link);
                prompt.replaceChildren(message);
                mount.setAttribute('hidden', '');
              });
              mount.after(scheduleScript);

              const observer = new MutationObserver(() => {
                if (addEventsTab()) observer.disconnect();
              });
              observer.observe(mount, { childList: true, subtree: true });
            };

            loadButton.addEventListener('click', loadSchedule, { once: true });
            if (view) loadSchedule();
          })();
        </script>
      </div>
    </div>
  </section>
</Base>

<style>
  :global(:root) {
    --momenceColorBackground: #fbfbfb;
    --momenceColorPrimary: 160, 44, 73;
    --momenceColorBlack: 3, 1, 13;
  }

  .schedule-section {
    min-height: 720px;
    padding: 2.5rem 0 5rem;
    background: #f8f5f0;
  }

  .schedule-widget {
    max-width: 760px;
    margin: 0 auto;
  }

  .embed-prompt {
    max-width: 620px;
    margin: 2rem auto 0;
    padding: 2.5rem 1.5rem;
    border-radius: 24px;
    background: var(--white);
    text-align: center;
    box-shadow: 0 18px 50px rgba(70, 31, 42, 0.1);
  }

  .embed-prompt h2 {
    margin-bottom: 0.75rem;
  }

  .load-widget {
    display: inline-flex;
    min-height: 48px;
    margin-top: 1rem;
    padding: 0.8rem 1.25rem;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 999px;
    background: var(--maroon);
    color: var(--white);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .load-widget:hover {
    background: var(--gold);
    color: var(--text);
  }

  .load-widget:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 3px;
  }

  .load-widget:disabled {
    opacity: 0.7;
    cursor: wait;
  }

  @media (min-width: 768px) {
    .schedule-section {
      padding: 2.5rem 0 7rem;
    }
  }
</style>
