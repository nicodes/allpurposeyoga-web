---
import Base from '../layouts/Layout.astro';
import Img from '../components/Img.astro';

const leadFormFields = JSON.stringify({
  firstName: { type: 'text', label: 'First name', required: true },
  lastName: { type: 'text', label: 'Last name', required: true },
  email: { type: 'email', label: 'Email', required: true },
  phoneNumber: { type: 'phone-number', label: 'Phone number', required: true },
  'lead-message': {
    type: 'text',
    label: 'Message',
    required: true,
    hidden: false,
    placeholder: 'Share any questions or interests you have with us!',
  },
});
---

<Base
  title="Connect | All Purpose Yoga"
  description="Connect with All Purpose Yoga at 2825 Wilderness Place, Boulder, CO 80301 or email info@allpurposeyoga.com."
>
  <section class="connect-section">
    <div class="container connect-layout">
      <div class="connect-primary">
        <Img
          src="/wp-content/uploads/2026/07/Gemini_Generated_Image_t90fpjt90fpjt90f-compressed.png"
          alt="Students resting in the All Purpose Yoga studio"
          widths={[480, 768, 1200]}
          sizes="(min-width: 900px) 58vw, calc(100vw - 2.5rem)"
          class="connect-studio-image"
        />

        <div class="contact-cards">
          <article class="contact-card">
            <svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true">
              <path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z" />
            </svg>
            <h2>Address</h2>
            <address>
              2825 Wilderness Place<br />
              Boulder, CO 80301
            </address>
          </article>

          <article class="contact-card">
            <svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true">
              <path fill="currentColor" d="M3 5h18a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Zm9 7 8-5H4l8 5Zm0 2.3L3 8.7V17h18V8.7l-9 5.6Z" />
            </svg>
            <h2>Email</h2>
            <a href="mailto:info@allpurposeyoga.com">info@allpurposeyoga.com</a>
            <p>Email is the best way to reach us.</p>
          </article>
        </div>

        <section class="opportunities" aria-label="Ways to join All Purpose Yoga">
          <article class="opportunity-card">
            <p class="opportunity-kicker">Work Trade at APY</p>
            <h2>Help care for the space you love.</h2>
            <p>
              We offer a limited number of work-trade opportunities in exchange for yoga at APY.
              Our work-trade team helps keep the studio clean, welcoming, and cared for, giving a
              little back to the space that gives so much to our community.
            </p>
            <a class="opportunity-link" href="mailto:info@allpurposeyoga.com?subject=APY%20Work-Trade%20Interest">
              Learn more <span aria-hidden="true">→</span>
            </a>
          </article>

          <article class="opportunity-card">
            <p class="opportunity-kicker">Want to Teach at APY?</p>
            <h2>Come serve your community through yoga.</h2>
            <p>
              We’re looking for heart-led, authentic teachers who want to create connection, hold
              meaningful space, and make yoga feel welcoming for everyone. If you see teaching as
              more than a job, as a way to contribute, connect, and serve, we’d love to hear from you.
            </p>
            <a class="opportunity-link" href="mailto:info@allpurposeyoga.com?subject=APY%20Teaching%20Application">
              Apply to teach at APY <span aria-hidden="true">→</span>
            </a>
          </article>
        </section>

        <div id="contact-form" class="lead-form" data-field-def={leadFormFields}>
          <div class="form-prompt" data-form-prompt>
            <p>Loading contact form...</p>
            <noscript>
              <a href="mailto:info@allpurposeyoga.com">Email the studio</a>
            </noscript>
          </div>
        </div>
      </div>

      <aside class="testimonials" aria-labelledby="testimonials-heading">
        <h2 id="testimonials-heading">Testimonials</h2>
        <figure>
          <blockquote>
            “This is such an incredible studio in Boulder. I had the pleasure of attending an early
            evening flow class and an afternoon special offering which was a yin yoga and essential
            oil. Both classes were top tier. The sense of community is just so comforting and I felt
            so welcomed as a new yogi. This is just what Boulder needed!!!”
          </blockquote>
          <figcaption>— M C</figcaption>
        </figure>
        <figure>
          <blockquote>
            “Such a calm, welcoming, and beautiful space! I’ve been to a couple classes here and
            felt welcomed in by the instructor and other participants. Chill, fun and relaxing folks
            here :) check it out!”
          </blockquote>
          <figcaption>— Allison S</figcaption>
        </figure>
      </aside>
    </div>
  </section>
</Base>

<script is:inline>
  (() => {
    const container = document.querySelector('.lead-form');
    const prompt = document.querySelector('[data-form-prompt]');

    if (!container || !prompt) return;

    const formScript = document.createElement('script');
    formScript.async = true;
    formScript.type = 'module';
    formScript.id = 'momence-plugin-lead-form-src';
    formScript.setAttribute('host_id', '87939');
    formScript.setAttribute('fields', 'firstName,lastName,email,phoneNumber,lead-message');
    formScript.setAttribute('token', 'zQ7O99NeXl');
    formScript.setAttribute('country_code', 'us');
    formScript.setAttribute('source_id', '82349');
    formScript.setAttribute('data-field-def', container.getAttribute('data-field-def') ?? '{}');
    formScript.src = 'https://momence.com/plugin/lead-form/lead-form.js';
    formScript.addEventListener('load', () => prompt.remove());
    formScript.addEventListener('error', () => {
      const message = document.createElement('p');
      const link = document.createElement('a');
      link.href = 'mailto:info@allpurposeyoga.com';
      link.textContent = 'info@allpurposeyoga.com';
      message.append('We could not load the form. Email us at ', link, '.');
      prompt.replaceChildren(message);
    });
    container.append(formScript);
  })();
</script>

<style>
  :global(:root) {
    --momenceColorBackground: #fbf7ea;
    --momenceColorPrimary: 160, 44, 73;
    --momenceColorBlack: 3, 1, 13;
  }

  .connect-section {
    padding: 3rem 0 5rem;
    background: linear-gradient(180deg, rgba(245, 234, 202, 0.58), rgba(245, 234, 202, 0.25));
  }

  .connect-layout {
    display: grid;
    gap: 3rem;
    align-items: start;
  }

  .connect-primary {
    min-width: 0;
  }

  :global(.connect-studio-image) {
    width: 100%;
    max-height: 540px;
    border-radius: 12px;
    object-fit: cover;
    box-shadow: 0 18px 50px rgba(70, 31, 42, 0.12);
  }

  .contact-cards {
    display: grid;
    gap: 1.4rem;
    width: calc(100% - 3rem);
    margin: -1rem auto 0;
  }

  .contact-card {
    padding: 1.5rem;
    border-radius: 24px;
    background: var(--white);
    text-align: center;
    box-shadow: 0 0 32px rgba(160, 44, 73, 0.3);
  }

  .contact-card svg {
    display: block;
    margin: 0 auto;
    color: var(--maroon);
  }

  .contact-card h2 {
    margin: 0.35rem 0 0.8rem;
    color: var(--maroon);
    font-size: 1.5rem;
    letter-spacing: 0;
  }

  .contact-card address {
    font-style: normal;
  }

  .contact-card a {
    overflow-wrap: anywhere;
  }

  .contact-card p {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
  }

  .opportunities {
    display: grid;
    gap: 1.25rem;
    margin: 3rem 0;
  }

  .opportunity-card {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border-radius: 24px;
    background: var(--maroon);
    color: var(--white);
    box-shadow: 0 18px 50px rgba(70, 31, 42, 0.14);
  }

  .opportunity-card h2 {
    color: var(--white);
    font-size: clamp(2rem, 5vw, 2.8rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
  }

  .opportunity-kicker {
    margin-bottom: 0.65rem;
    color: var(--cream);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .opportunity-link {
    align-self: flex-start;
    margin-top: auto;
    padding-top: 0.75rem;
    color: var(--white);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .opportunity-link:hover {
    color: var(--gold);
  }

  .lead-form {
    min-height: 390px;
  }

  .form-prompt {
    max-width: 620px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
    border-radius: 24px;
    background: var(--white);
    text-align: center;
    box-shadow: 0 18px 50px rgba(70, 31, 42, 0.1);
  }

  .form-prompt p {
    margin: 0;
  }

  .testimonials {
    padding: 2rem;
    border-radius: 12px;
    background: var(--white);
    box-shadow: 0 18px 50px rgba(70, 31, 42, 0.1);
  }

  .testimonials h2 {
    margin-bottom: 1.5rem;
    font-size: 2rem;
    letter-spacing: -0.04em;
  }

  .testimonials figure {
    margin: 0;
  }

  .testimonials figure + figure {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(51, 51, 51, 0.12);
  }

  .testimonials blockquote {
    margin: 0 0 0.75rem;
    font-style: italic;
  }

  .testimonials figcaption {
    color: var(--maroon);
    font-weight: 600;
  }

  @media (min-width: 640px) {
    .contact-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: calc(100% - 5rem);
      margin-top: -3rem;
    }

    .opportunities {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .connect-section {
      padding-bottom: 6rem;
    }

    .connect-layout {
      grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr);
      gap: 2.5rem;
    }

    .testimonials {
      position: sticky;
      top: 110px;
    }
  }
</style>
