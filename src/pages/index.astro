---
import Base from '../layouts/Layout.astro';
import Img from '../components/Img.astro';

const classes = [
  {
    name: 'Vinyasa',
    image: '/wp-content/uploads/2025/08/Flow.png',
    description: 'One breath, one movement. A dynamic flow for beginners and experienced yogis alike.',
  },
  {
    name: 'Gentle',
    image: '/wp-content/uploads/2025/08/Gentle.png',
    description: 'A slower practice for strengthening, stretching, breathwork, and deep relaxation.',
  },
  {
    name: 'Yin',
    image: '/wp-content/uploads/2025/08/Yin-compressed-1.png',
    description: 'Longer-held, supported postures for joint health, mobility, and mindful presence.',
  },
  {
    name: 'Kundalini',
    image: '/wp-content/uploads/2025/08/Power.png',
    description: 'Breath, mantra, meditation, and movement in the Yoga of Awareness.',
  },
  {
    name: 'Vin Yin',
    image: '/wp-content/uploads/2025/08/Gentle.png',
    description: 'An energizing vinyasa flow followed by a receptive, restful Yin practice.',
  },
  {
    name: 'Restorative Yin & Sound Healing',
    image: '/wp-content/uploads/2025/08/Gentle.png',
    description: 'Supported poses, mindful breathing, and the resonance of bowls, mantra, and live music.',
  },
  {
    name: 'Sound Healing',
    image: '/wp-content/uploads/2025/08/Yin-compressed-1.png',
    description: 'An immersive sound bath created for deep rest, calm, and renewal.',
  },
];

const memberships = [
  {
    name: 'New students',
    price: '$50',
    unit: 'two weeks unlimited',
    href: 'https://momence.com/All-Purpose-Yoga/membership/%2450-For-2-Weeks-Unlimited-/668633?sessionId=124183999',
  },
  {
    name: 'Class pack',
    price: '$40',
    unit: 'three classes',
    href: 'https://momence.com/All-Purpose-Yoga/membership/3-Classes-for-%2440/519940',
  },
  {
    name: 'Unlimited',
    price: '$129',
    unit: 'per month',
    href: 'https://momence.com/All-Purpose-Yoga/membership/Sangha-Unlimited-Membership/853879',
  },
  {
    name: 'Reduced rate unlimited',
    price: '$99',
    unit: 'per month',
    href: 'https://momence.com/All-Purpose-Yoga/membership/Sangha-Student-Unlimited-Membership/853881',
  },
];

const classCards = [
  {
    name: '5 classes',
    price: '$130',
    expiry: '3 month expiration',
    href: 'https://momence.com/All-Purpose-Yoga/membership/5-Class-Card/570277',
  },
  {
    name: '10 classes',
    price: '$220',
    expiry: '6 month expiration',
    href: 'https://momence.com/All-Purpose-Yoga/membership/10-Class-Card/570278',
  },
  {
    name: '20 classes',
    price: '$400',
    expiry: '12 month expiration',
    href: 'https://momence.com/All-Purpose-Yoga/membership/20-Class-Card/570283',
  },
];
---

<Base
  title="All Purpose Yoga | Boulder, Colorado"
  description="Practice yoga in Boulder, CO at All Purpose Yoga. Explore our schedule, classes, pricing, and welcoming studio community."
>
  <section class="v2-hero">
    <Img
      src="/wp-content/uploads/2025/12/IMG_0033.jpeg"
      alt="A restorative yoga class at All Purpose Yoga"
      widths={[640, 1440]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      quality={55}
      class="v2-hero-img"
    />
    <div class="v2-hero-shade"></div>
    <div class="container v2-hero-content">
      <p class="v2-eyebrow">Yoga for everyday life · Boulder, Colorado</p>
      <h1>Find the practice<br />that meets you here.</h1>
      <p class="v2-intro">
        A locally operated, female owned studio for all levels, all goals, and all people.
      </p>
      <div class="hero-actions">
        <a class="action action-primary" href="#schedule">View the schedule</a>
        <a class="action action-secondary" href="#classes">Explore classes</a>
      </div>
    </div>
    <a class="scroll-cue" href="#schedule">
      <span>Start here</span>
      <span aria-hidden="true">↓</span>
    </a>
  </section>

  <section id="schedule" class="v2-section schedule-section">
    <div class="container schedule-layout">
      <div class="section-copy">
        <p class="v2-kicker">Make space for yourself</p>
        <h2>Your next practice starts here.</h2>
        <p>
          Move, breathe, rest, and reconnect. Our weekly schedule brings together Vinyasa, Gentle,
          Yin, Kundalini, restorative practices, and sound healing in one welcoming space.
        </p>
        <ul class="schedule-notes">
          <li>No added heat</li>
          <li>All levels welcome</li>
          <li>Live stream classes available</li>
          <li>Studio mats available</li>
        </ul>
      </div>

      <div class="schedule-card">
        <p class="schedule-label">Live class calendar</p>
        <p class="schedule-day">Practice this week</p>
        <p>
          The live schedule, teacher details, and booking are hosted securely on Momence.
        </p>
        <a class="action action-light" href="https://momence.com/u/all-purpose-yoga-bp11O7">Open live schedule</a>
        <p class="schedule-fine">New here? Start with two weeks unlimited for $50.</p>
      </div>
    </div>
  </section>

  <section id="classes" class="v2-section classes-section">
    <div class="container">
      <div class="section-heading-row">
        <div>
          <p class="v2-kicker">How do you like to practice?</p>
          <h2>Something for everyone.</h2>
        </div>
        <p>
          Build heat, slow down, listen inward, or settle into sound. Choose the practice your day
          is asking for.
        </p>
      </div>

      <div class="class-list">
        {classes.map((practice) => (
          <article class="practice-card">
            <Img
              src={practice.image}
              alt=""
              widths={[240, 420]}
              sizes="(min-width: 900px) 180px, 96px"
              class="practice-icon"
            />
            <div>
              <h3>{practice.name}</h3>
              <p>{practice.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="pricing" class="v2-section pricing-section">
    <div class="container">
      <div class="pricing-lead">
        <div>
          <p class="v2-kicker light">Begin where you are</p>
          <h2>A simple way into practice.</h2>
        </div>
        <p>
          Start with our two-week unlimited offer, choose a monthly rhythm, or keep things flexible
          with a class card.
        </p>
      </div>

      <div class="membership-grid">
        {memberships.map((plan, index) => (
          <a class:list={['membership', { featured: index === 0 }]} href={plan.href}>
            {index === 0 && <span class="best-value">Best place to begin</span>}
            <span class="membership-name">{plan.name}</span>
            <strong>{plan.price}</strong>
            <span>{plan.unit}</span>
            <span class="membership-link">Choose this option →</span>
          </a>
        ))}
      </div>

      <div class="class-card-row">
        <p>Prefer a class card?</p>
        {classCards.map((card) => (
          <a class="class-card" href={card.href}>
            <strong>{card.name}</strong>
            <span>{card.price} · {card.expiry}</span>
          </a>
        ))}
      </div>

      <p class="reduced-rate">
        Reduced unlimited membership is offered to students, first responders, military, seniors,
        healthcare workers, and teachers.
      </p>
    </div>
  </section>

  <section id="connect" class="v2-section connect-section">
    <div class="container connect-layout">
      <div class="connect-heading">
        <p class="v2-kicker">Come as you are</p>
        <h2>Meet us on the mat.</h2>
      </div>

      <div class="connect-details">
        <div>
          <span class="detail-label">Studio</span>
          <address>
            2825 Wilderness Place<br />
            Boulder, CO 80301
          </address>
        </div>
        <div>
          <span class="detail-label">Reach us</span>
          <a href="tel:2035205145">203-520-5145</a>
          <a href="mailto:info@allpurposeyoga.com">info@allpurposeyoga.com</a>
        </div>
      </div>

      <div class="connect-actions">
        <a class="action action-primary" href="#schedule">Book a class</a>
        <a class="action action-outline" href="mailto:info@allpurposeyoga.com">Email the studio</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .v2-hero {
    min-height: calc(100svh - 64px);
    position: relative;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: var(--white);
  }

  :global(.v2-hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% center;
  }

  .v2-hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(26, 20, 17, 0.86) 0%, rgba(26, 20, 17, 0.5) 48%, rgba(26, 20, 17, 0.08) 78%),
      linear-gradient(0deg, rgba(26, 20, 17, 0.5) 0%, transparent 45%);
  }

  .v2-hero-content {
    position: relative;
    z-index: 2;
    padding-top: 8rem;
    padding-bottom: 7rem;
  }

  .v2-eyebrow,
  .v2-kicker {
    margin: 0 0 1rem;
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .v2-eyebrow {
    color: #f4d77d;
  }

  .v2-kicker {
    color: var(--maroon);
  }

  .v2-kicker.light {
    color: #f4d77d;
  }

  .v2-hero h1 {
    max-width: 880px;
    margin: 0;
    color: var(--white);
    font-size: clamp(3rem, 9vw, 7rem);
    line-height: 0.94;
    letter-spacing: -0.065em;
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.35);
  }

  .v2-intro {
    max-width: 590px;
    margin: 1.75rem 0 0;
    font-size: clamp(1rem, 2vw, 1.25rem);
  }

  .hero-actions,
  .connect-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .action {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.4rem;
    border: 2px solid transparent;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: 180ms ease;
  }

  .action:hover {
    transform: translateY(-2px);
  }

  .action:focus-visible,
  .scroll-cue:focus-visible,
  .membership:focus-visible,
  .class-card:focus-visible {
    outline: 3px solid #f4d77d;
    outline-offset: 4px;
  }

  .connect-actions .action:focus-visible {
    outline-color: var(--maroon);
  }

  .action-primary {
    background: var(--maroon);
    color: var(--white);
  }

  .action-primary:hover {
    background: #7d2038;
    color: var(--white);
  }

  .action-secondary {
    border-color: rgba(255, 255, 255, 0.76);
    background: rgba(255, 255, 255, 0.12);
    color: var(--white);
    backdrop-filter: blur(8px);
  }

  .action-secondary:hover {
    background: var(--white);
    color: var(--maroon);
  }

  .action-light {
    background: var(--cream);
    color: var(--maroon);
  }

  .action-outline {
    border-color: var(--maroon);
    color: var(--maroon);
  }

  .scroll-cue {
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 2;
    display: none;
    align-items: center;
    gap: 0.7rem;
    color: var(--white);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .scroll-cue span:last-child {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 50%;
  }

  .v2-section {
    scroll-margin-top: 82px;
    padding: 5.5rem 0;
  }

  .v2-section h2 {
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 5.4rem);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .schedule-section {
    background: #f9f5e7;
  }

  .schedule-layout {
    display: grid;
    gap: 2.5rem;
  }

  .section-copy > p:not(.v2-kicker) {
    max-width: 650px;
    margin-top: 1.5rem;
    font-size: 1.06rem;
  }

  .schedule-notes {
    display: grid;
    gap: 0.65rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .schedule-notes li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .schedule-notes li::before {
    content: "";
    width: 7px;
    height: 7px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--gold);
  }

  .schedule-card {
    align-self: stretch;
    padding: 2.25rem;
    border-radius: 28px;
    background: var(--maroon);
    color: var(--white);
    box-shadow: 0 24px 70px rgba(99, 30, 49, 0.2);
  }

  .schedule-label,
  .detail-label {
    display: block;
    margin: 0 0 1rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .schedule-day {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 1;
  }

  .schedule-card > p:not(.schedule-day, .schedule-label, .schedule-fine) {
    max-width: 440px;
  }

  .schedule-fine {
    margin: 1.4rem 0 0;
    font-size: 0.8rem;
    opacity: 0.8;
  }

  .classes-section {
    background: var(--white);
  }

  .section-heading-row {
    display: grid;
    gap: 1.5rem;
    align-items: end;
    margin-bottom: 3rem;
  }

  .section-heading-row > p {
    max-width: 520px;
  }

  .class-list {
    border-top: 1px solid rgba(51, 51, 51, 0.18);
  }

  .practice-card {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 1rem;
    align-items: center;
    padding: 1.25rem 0;
    border-bottom: 1px solid rgba(51, 51, 51, 0.18);
  }

  :global(.practice-icon) {
    width: 72px;
    height: 72px;
    object-fit: contain;
  }

  .practice-card h3 {
    margin: 0 0 0.25rem;
    color: var(--text);
    font-size: clamp(1.45rem, 4vw, 2.1rem);
  }

  .practice-card p {
    margin: 0;
    font-size: 0.9rem;
  }

  .pricing-section {
    background: #6d263d;
    color: var(--white);
  }

  .pricing-section h2 {
    color: var(--white);
  }

  .pricing-lead {
    display: grid;
    gap: 1.5rem;
    align-items: end;
    margin-bottom: 3rem;
  }

  .pricing-lead > p {
    max-width: 520px;
  }

  .membership-grid {
    display: grid;
    gap: 1rem;
  }

  .membership {
    position: relative;
    display: flex;
    min-height: 260px;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 24px;
    color: var(--white);
    transition: 180ms ease;
  }

  .membership:hover {
    transform: translateY(-4px);
    border-color: var(--gold);
    color: var(--white);
  }

  .membership.featured {
    background: var(--cream);
    color: var(--maroon);
  }

  .membership.featured:hover {
    color: var(--maroon);
  }

  .best-value {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .membership-name {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .membership strong {
    margin: 0.35rem 0;
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 8vw, 5.2rem);
    font-weight: 400;
    line-height: 1;
  }

  .membership-link {
    margin-top: 1.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .class-card-row {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
    padding: 1.5rem;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.08);
  }

  .class-card-row p,
  .class-card-row a,
  .class-card-row strong,
  .class-card-row span {
    display: block;
    margin: 0;
  }

  .class-card {
    padding: 0.55rem;
    border-radius: 10px;
    color: var(--white);
    transition: 180ms ease;
  }

  .class-card:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--white);
  }

  .class-card-row p,
  .class-card-row strong {
    font-weight: 700;
  }

  .class-card-row span {
    font-size: 0.8rem;
    opacity: 0.75;
  }

  .reduced-rate {
    max-width: 740px;
    margin: 2rem auto 0;
    text-align: center;
    font-size: 0.85rem;
    opacity: 0.82;
  }

  .connect-section {
    background: #f9f5e7;
  }

  .connect-layout {
    display: grid;
    gap: 2.5rem;
  }

  .connect-details {
    display: grid;
    gap: 2rem;
    padding: 2rem 0;
    border-top: 1px solid rgba(51, 51, 51, 0.16);
    border-bottom: 1px solid rgba(51, 51, 51, 0.16);
  }

  .connect-details address {
    font-style: normal;
  }

  .connect-details a {
    display: block;
    width: fit-content;
    color: var(--maroon);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 700px) {
    .scroll-cue {
      display: flex;
    }

    .schedule-layout {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: stretch;
    }

    .section-heading-row,
    .pricing-lead {
      grid-template-columns: 1.25fr 0.75fr;
    }

    .practice-card {
      grid-template-columns: 110px 1fr;
      gap: 1.5rem;
      padding: 1.5rem 0;
    }

    :global(.practice-icon) {
      width: 96px;
      height: 96px;
    }

    .membership-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .class-card-row {
      grid-template-columns: 1.25fr repeat(3, 1fr);
      align-items: center;
    }

    .connect-details {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .v2-hero {
      min-height: calc(100svh - 76px);
    }

    .v2-hero-content {
      padding-bottom: 8rem;
    }

    .v2-section {
      padding: 8rem 0;
    }

    .schedule-layout {
      gap: 6rem;
    }

    .schedule-card {
      padding: 3rem;
    }

    .membership-grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .connect-layout {
      grid-template-columns: 1.1fr 0.9fr;
      align-items: end;
    }

    .connect-heading {
      grid-row: 1 / span 2;
    }

    .connect-actions {
      margin: 0;
    }
  }

  @media (min-width: 1024px) {
    .v2-section {
      scroll-margin-top: 94px;
    }
  }
</style>
