---
import Base from '../layouts/Layout.astro';
import Img from '../components/Img.astro';

const classes = [
  {
    name: 'Vinyasa',
    image: '/wp-content/uploads/2025/08/Flow.png',
  },
  {
    name: 'Gentle',
    image: '/wp-content/uploads/2025/08/Gentle.png',
  },
  {
    name: 'Yin',
    image: '/wp-content/uploads/2025/08/Yin-compressed-1.png',
  },
  {
    name: 'Kundalini',
    image: '/wp-content/uploads/2025/08/Power.png',
  },
  {
    name: 'Vin Yin',
    image: '/wp-content/uploads/2025/08/Gentle.png',
  },
  {
    name: 'Restorative Yin & Sound Healing',
    image: '/wp-content/uploads/2025/08/Gentle.png',
  },
  {
    name: 'Sound Healing',
    image: '/wp-content/uploads/2025/08/Yin-compressed-1.png',
  },
];

const memberships = [
  {
    name: 'New students',
    price: '$50',
    unit: 'two weeks unlimited',
    href: 'https://momence.com/All-Purpose-Yoga/membership/%2450-For-2-Weeks-Unlimited-/668633?sessionId=124183999',
  },
  {
    name: 'Drop in',
    price: '$28',
    unit: 'one class',
    href: 'https://momence.com/All-Purpose-Yoga/membership/3-Classes-for-%2440/519940',
  },
  {
    name: 'Unlimited',
    price: '$129',
    unit: 'per month',
    href: 'https://momence.com/All-Purpose-Yoga/membership/Sangha-Unlimited-Membership/853879',
  },
  {
    name: 'Reduced rate unlimited',
    price: '$99',
    unit: 'per month',
    href: 'https://momence.com/All-Purpose-Yoga/membership/Sangha-Student-Unlimited-Membership/853881',
  },
];

const classCards = [
  ['5 classes', '$130', '3 month expiration'],
  ['10 classes', '$220', '6 month expiration'],
  ['20 classes', '$400', '12 month expiration'],
];
---

<Base
  title="All Purpose Yoga | Boulder, Colorado"
  description="Practice yoga in Boulder, CO at All Purpose Yoga. Explore our schedule, classes, pricing, and welcoming studio community."
>
  <section class="v2-hero">
    <Img
      src="/wp-content/uploads/2025/12/IMG_0033.jpeg"
      alt="A restorative yoga class at All Purpose Yoga"
      widths={[640, 1440]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      quality={55}
      class="v2-hero-img"
    />
    <div class="v2-hero-shade"></div>
    <div class="container v2-hero-content">
      <h1>Find the practice<br />that meets you here.</h1>
      <p class="v2-intro">
        A locally operated, female owned studio for all levels, all goals, and all people. Located in
        Boulder Colorado.
      </p>
      <div class="hero-actions">
        <a class="action action-primary" href="/schedule/">View the schedule</a>
        <a class="action action-secondary" href="/connect/">Get in touch</a>
      </div>
    </div>
  </section>

  <section id="schedule" class="v2-section schedule-section">
    <div class="container schedule-layout">
      <div class="section-copy">
        <h2>Your next practice starts here.</h2>
        <p>
          Move, breathe, rest, and reconnect. Our weekly schedule brings together Vinyasa, Gentle,
          Yin, Kundalini, restorative practices, and sound healing in one welcoming space.
        </p>
        <ul class="schedule-notes">
          <li>No added heat</li>
          <li>All levels welcome</li>
          <li>Live stream classes available</li>
          <li>Studio mats available</li>
        </ul>
      </div>

      <div class="schedule-card">
        <p class="schedule-day">Practice this week</p>
        <p>
          The live schedule, teacher details, and booking are hosted securely on Momence.
        </p>
        <a class="action action-light" href="/schedule/">Open live schedule</a>
        <p class="schedule-fine">New here? Start with two weeks unlimited for $50.</p>
      </div>
    </div>
  </section>

  <section id="classes" class="v2-section classes-section">
    <div class="container">
      <div class="section-heading-row">
        <div>
          <h2>Something for everyone.</h2>
        </div>
      </div>

      <div class="class-list">
        {classes.map((practice) => (
          <a class="practice-card" href="/schedule/">
            <Img
              src={practice.image}
              alt=""
              widths={[160, 240]}
              sizes="(min-width: 1000px) 112px, 88px"
              class="practice-icon"
            />
            <h3>{practice.name}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="pricing" class="v2-section pricing-section">
    <div class="container">
      <div class="pricing-lead">
        <div>
          <h2>A simple way into practice.</h2>
        </div>
      </div>

      <div class="membership-grid">
        {memberships.map((plan, index) => (
          <a class:list={['membership', { featured: index === 0 }]} href={plan.href}>
            <span class="membership-name">{plan.name}</span>
            <strong>{plan.price}</strong>
            <span>{plan.unit}</span>
            <span class="membership-link">Choose this option →</span>
          </a>
        ))}
      </div>

      <div class="class-card-row">
        <p>Prefer a class card?</p>
        {classCards.map(([name, price, expiry]) => (
          <div>
            <strong>{name}</strong>
            <span>{price} · {expiry}</span>
          </div>
        ))}
      </div>

      <p class="reduced-rate">
        Reduced unlimited membership is offered to students, first responders, military, seniors,
        healthcare workers, and teachers.
      </p>
    </div>
  </section>

</Base>

<style>
  .v2-hero {
    min-height: calc(100svh - 64px);
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: var(--white);
  }

  :global(.v2-hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% center;
  }

  .v2-hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(26, 20, 17, 0.86) 0%, rgba(26, 20, 17, 0.5) 48%, rgba(26, 20, 17, 0.08) 78%),
      linear-gradient(0deg, rgba(26, 20, 17, 0.5) 0%, transparent 45%);
  }

  .v2-hero-content {
    position: relative;
    z-index: 2;
    padding-block: clamp(4rem, 8vh, 6rem);
  }

  .v2-hero h1 {
    max-width: 880px;
    margin: 0;
    color: var(--white);
    font-size: clamp(3rem, 9vw, 7rem);
    line-height: 0.94;
    letter-spacing: -0.065em;
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.35);
  }

  .v2-intro {
    max-width: 590px;
    margin: 1.75rem 0 0;
    font-size: clamp(1rem, 2vw, 1.25rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .action {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.4rem;
    border: 2px solid transparent;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: 180ms ease;
  }

  .action:hover {
    transform: translateY(-2px);
  }

  .action-primary {
    background: var(--maroon);
    color: var(--white);
  }

  .action-primary:hover {
    background: #7d2038;
    color: var(--white);
  }

  .action-secondary {
    border-color: rgba(255, 255, 255, 0.76);
    background: rgba(255, 255, 255, 0.12);
    color: var(--white);
    backdrop-filter: blur(8px);
  }

  .action-secondary:hover {
    background: var(--white);
    color: var(--maroon);
  }

  .action-light {
    background: var(--cream);
    color: var(--maroon);
  }

  .action-outline {
    border-color: var(--maroon);
    color: var(--maroon);
  }

  .v2-section {
    scroll-margin-top: 82px;
    padding: 5.5rem 0;
  }

  .v2-section h2 {
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 5.4rem);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .schedule-section {
    background: #f9f5e7;
  }

  .schedule-layout {
    display: grid;
    gap: 2.5rem;
  }

  .section-copy > p {
    max-width: 650px;
    margin-top: 1.5rem;
    font-size: 1.06rem;
  }

  .schedule-notes {
    display: grid;
    gap: 0.65rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .schedule-notes li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .schedule-notes li::before {
    content: "";
    width: 7px;
    height: 7px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--gold);
  }

  .schedule-card {
    align-self: stretch;
    padding: 2.25rem;
    border-radius: 28px;
    background: var(--maroon);
    color: var(--white);
    box-shadow: 0 24px 70px rgba(99, 30, 49, 0.2);
  }

  .schedule-day {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 1;
  }

  .schedule-card > p:not(.schedule-day, .schedule-fine) {
    max-width: 440px;
  }

  .schedule-fine {
    margin: 1.4rem 0 0;
    font-size: 0.8rem;
    opacity: 0.8;
  }

  .classes-section {
    background: var(--white);
  }

  .section-heading-row,
  .pricing-lead {
    margin-bottom: 3rem;
  }

  .class-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1rem;
  }

  .practice-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    align-items: center;
    color: var(--text);
    text-align: center;
    text-decoration: none;
    transition: transform 180ms ease;
  }

  .practice-card:hover {
    color: var(--maroon);
    transform: translateY(-4px);
  }

  .practice-card:focus-visible {
    border-radius: 12px;
    outline: 3px solid var(--maroon);
    outline-offset: 6px;
  }

  :global(.practice-icon) {
    width: 88px;
    height: 88px;
    object-fit: contain;
  }

  .practice-card h3 {
    margin: 0;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    line-height: 1.2;
  }

  .pricing-section {
    background: #6d263d;
    color: var(--white);
  }

  .pricing-section h2 {
    color: var(--white);
  }

  .membership-grid {
    display: grid;
    gap: 1rem;
  }

  .membership {
    position: relative;
    display: flex;
    min-height: 260px;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 24px;
    color: var(--white);
    transition: 180ms ease;
  }

  .membership:hover {
    transform: translateY(-4px);
    border-color: var(--gold);
    color: var(--white);
  }

  .membership.featured {
    background: var(--cream);
    color: var(--maroon);
  }

  .membership.featured:hover {
    color: var(--maroon);
  }

  .membership-name {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .membership strong {
    margin: 0.35rem 0;
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 8vw, 5.2rem);
    font-weight: 400;
    line-height: 1;
  }

  .membership-link {
    margin-top: 1.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .class-card-row {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
    padding: 1.5rem;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.08);
  }

  .class-card-row p,
  .class-card-row strong,
  .class-card-row span {
    display: block;
    margin: 0;
  }

  .class-card-row p,
  .class-card-row strong {
    font-weight: 700;
  }

  .class-card-row span {
    font-size: 0.8rem;
    opacity: 0.75;
  }

  .reduced-rate {
    max-width: 740px;
    margin: 2rem auto 0;
    text-align: center;
    font-size: 0.85rem;
    opacity: 0.82;
  }

  @media (min-width: 700px) {
    .schedule-layout {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: stretch;
    }

    .class-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .membership-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .class-card-row {
      grid-template-columns: 1.25fr repeat(3, 1fr);
      align-items: center;
    }

  }

  @media (min-width: 1000px) {
    .v2-hero {
      min-height: calc(100svh - 76px);
    }

    .v2-section {
      padding: 8rem 0;
    }

    .schedule-layout {
      gap: 6rem;
    }

    .schedule-card {
      padding: 3rem;
    }

    .class-list {
      grid-template-columns: repeat(7, minmax(0, 1fr));
    }

    :global(.practice-icon) {
      width: 112px;
      height: 112px;
    }

    .membership-grid {
      grid-template-columns: repeat(4, 1fr);
    }

  }

  @media (min-width: 1024px) {
    .v2-section {
      scroll-margin-top: 94px;
    }
  }
</style>
